<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_book_transaction_form" model="ir.ui.view">
        <field name="name">daily.book.transaction.form</field>
        <field name="model">daily.book.transaction</field>
        <field name="arch" type="xml">
            <form string="Daily Transaction">
                <sheet>
                    <div class="oe_title">
                        <h1>Daily Transaction</h1>
                    </div>
                    <group>
                        <group>
                            <field name="transaction_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="available_head_ids" invisible="1"/>
                            <field name="partner_required" invisible="1"/>
                            <field name="head_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="partner_id"
                                   invisible="not partner_required"
                                   required="partner_required"
                                   options="{'no_create': True, 'no_edit': True}"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="cash_book_id"
                               invisible="transaction_type not in ('cash_in', 'cash_out')"
                               required="transaction_type in ('cash_in', 'cash_out')"
                               options="{'no_create': True, 'no_edit': True}"/>
                        <field name="bank_book_id"
                               invisible="transaction_type not in ('bank_in', 'bank_out')"
                               required="transaction_type in ('bank_in', 'bank_out')"
                               options="{'no_create': True, 'no_edit': True}"/>
                        <field name="description" placeholder="Defaults to the selected Head; you can edit it"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Enter a positive amount. The system automatically applies In or Out and updates Receivables when required.
                    </div>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button name="action_save_and_new" type="object" string="Save &amp; New" class="btn-secondary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_daily_expense" model="ir.actions.act_window">
        <field name="name">New Expense</field>
        <field name="res_model">daily.book.transaction</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_daily_book_transaction_form"/>
        <field name="target">new</field>
        <field name="context">{'default_transaction_type': 'expense'}</field>
    </record>

    <record id="action_daily_cash_transaction" model="ir.actions.act_window">
        <field name="name">Cash In/Out</field>
        <field name="res_model">daily.book.transaction</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_daily_book_transaction_form"/>
        <field name="target">new</field>
        <field name="context">{'default_transaction_type': 'cash_in'}</field>
    </record>

    <record id="action_daily_bank_transaction" model="ir.actions.act_window">
        <field name="name">Bank In/Out</field>
        <field name="res_model">daily.book.transaction</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_daily_book_transaction_form"/>
        <field name="target">new</field>
        <field name="context">{'default_transaction_type': 'bank_in'}</field>
    </record>

</odoo>
