<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_receivable_automation" model="ir.ui.view">
        <field name="name">purchase.order.form.receivable.automation</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_receivable_lines" type="object" class="oe_stat_button"
                        icon="fa-money" groups="odx_books.group_receivable_book_user,odx_books.group_book_manager"
                        invisible="receivable_line_count == 0">
                    <field name="receivable_line_count" widget="statinfo" string="Receivable"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
