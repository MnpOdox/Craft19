<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_receivable_form_automation_sources" model="ir.ui.view">
        <field name="name">receivable.book.form.automation.sources</field>
        <field name="model">receivable.book</field>
        <field name="inherit_id" ref="odx_books.view_book_receivable_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='receivable_line_ids']/list/field[@name='date']" position="after">
                <field name="partner_id" optional="show" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='receivable_line_ids']/list/field[@name='description']" position="after">
                <field name="source_type" optional="show"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="expense_book_id" optional="show"/>
                <field name="pos_order_id" optional="show"/>
                <field name="pos_session_id" optional="hide"/>
                <field name="cash_book_line_id" optional="hide"/>
                <field name="bank_book_line_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='receivable_line_ids']/form//field[@name='date']" position="after">
                <field name="partner_id" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='receivable_line_ids']/form//field[@name='description']" position="after">
                <field name="source_type" readonly="1"/>
                <field name="purchase_order_id" readonly="1"/>
                <field name="expense_book_id" readonly="1"/>
                <field name="pos_order_id" readonly="1"/>
                <field name="pos_session_id" readonly="1"/>
                <field name="cash_book_line_id" readonly="1"/>
                <field name="bank_book_line_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_receivable_automation_line_list" model="ir.ui.view">
        <field name="name">receivable.book.line.automation.list</field>
        <field name="model">receivable.book.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="description"/>
                <field name="source_type"/>
                <field name="amount" sum="Total"/>
                <field name="purchase_order_id" optional="show"/>
                <field name="expense_book_id" optional="show"/>
                <field name="pos_order_id" optional="show"/>
                <field name="pos_session_id" optional="hide"/>
                <field name="cash_book_line_id" optional="hide"/>
                <field name="bank_book_line_id" optional="hide"/>
                <field name="receivable_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_receivable_automation_line_form" model="ir.ui.view">
        <field name="name">receivable.book.line.automation.form</field>
        <field name="model">receivable.book.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="description"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="source_type"/>
                            <field name="purchase_order_id"/>
                            <field name="expense_book_id"/>
                            <field name="pos_order_id"/>
                            <field name="pos_session_id"/>
                            <field name="cash_book_line_id"/>
                            <field name="bank_book_line_id"/>
                            <field name="receivable_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
