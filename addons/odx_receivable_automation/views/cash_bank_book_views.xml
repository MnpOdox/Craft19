<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_book_form_receivable_automation" model="ir.ui.view">
        <field name="name">cash.book.form.receivable.automation</field>
        <field name="model">cash.book</field>
        <field name="inherit_id" ref="odx_books.view_cash_book_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cash_line_ids']/list/field[@name='head_id']" position="after">
                <field name="partner_id"
                       domain="[('has_confirmed_receivable_book', '=', True)]"/>
            </xpath>
            <xpath expr="//field[@name='cash_line_ids']/form//field[@name='head_id']" position="after">
                <field name="partner_id" domain="[('has_confirmed_receivable_book', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_bank_book_form_receivable_automation" model="ir.ui.view">
        <field name="name">bank.book.form.receivable.automation</field>
        <field name="model">bank.book</field>
        <field name="inherit_id" ref="odx_books.view_bank_book_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_line_ids']/list/field[@name='head_id']" position="after">
                <field name="partner_id"
                       domain="[('has_confirmed_receivable_book', '=', True)]"/>
            </xpath>
            <xpath expr="//field[@name='bank_line_ids']/form//field[@name='head_id']" position="after">
                <field name="partner_id" domain="[('has_confirmed_receivable_book', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
