        <field name="name">Books</field>
        <field name="sequence">5</field>
    </record>

    <record id="menu_book_transactions" model="ir.ui.menu">
        <field name="name">Transaction</field>
        <field name="parent_id" ref="odx_books.menu_book_root"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('odx_books.group_book_manager')])]"/>
