    </record>

    <record id="odx_books.menu_book_expense" model="ir.ui.menu">
        <field name="parent_id" ref="menu_book_transactions"/>
        <field name="group_ids" eval="[(6, 0, [ref('odx_books.group_book_manager')])]"/>
    </record>

    <record id="odx_books.menu_receivable_books" model="ir.ui.menu">
        <field name="parent_id" ref="menu_book_transactions"/>
        <field name="group_ids" eval="[(6, 0, [ref('odx_books.group_book_manager')])]"/>
    </record>

    <record id="odx_books.menu_configuration" model="ir.ui.menu">
        <field name="sequence">15</field>
        <field name="group_ids" eval="[(6, 0, [ref('odx_books.group_book_manager')])]"/>
    </record>
</odoo>
