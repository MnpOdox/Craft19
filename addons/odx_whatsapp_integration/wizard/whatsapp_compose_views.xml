<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_compose_form" model="ir.ui.view">
        <field name="name">odx.whatsapp.compose.form</field><field name="model">odx.whatsapp.compose</field>
        <field name="arch" type="xml"><form string="Send WhatsApp Message"><group><field name="lead_id" readonly="1"/><field name="company_id" invisible="1"/><field name="account_id"/><field name="mode"/></group>
            <group invisible="mode != 'text'"><field name="body" placeholder="Message..."/></group>
            <group invisible="mode != 'template'"><field name="template_id" required="mode == 'template'"/><field name="template_parameters" placeholder='["Customer", "Reference"]'/></group>
            <group invisible="mode != 'media'"><field name="media_type" required="mode == 'media'"/><field name="attachment" filename="attachment_name" required="mode == 'media'"/><field name="attachment_name" invisible="1"/><field name="body" placeholder="Optional caption"/></group>
            <footer><button name="action_send" string="Send" type="object" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field>
    </record>
</odoo>
