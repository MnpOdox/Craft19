<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_whatsapp_template_sync" model="ir.cron">
        <field name="name">WhatsApp: synchronize templates</field><field name="model_id" ref="model_odx_whatsapp_account"/>
        <field name="state">code</field><field name="code">model._cron_sync_templates()</field>
        <field name="interval_number">6</field><field name="interval_type">hours</field><field name="active" eval="True"/>
    </record>
    <record id="ir_cron_whatsapp_event_retry" model="ir.cron">
        <field name="name">WhatsApp: retry failed webhook events</field><field name="model_id" ref="model_odx_whatsapp_event"/>
        <field name="state">code</field><field name="code">model._cron_retry()</field>
        <field name="interval_number">5</field><field name="interval_type">minutes</field><field name="active" eval="True"/>
    </record>
    <record id="ir_cron_meta_whatsapp_followup" model="ir.cron">
        <field name="name">Meta Leads: process WhatsApp follow-ups</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_whatsapp_followup_automation()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_whatsapp_salesperson_notification_retry" model="ir.cron">
        <field name="name">WhatsApp: retry salesperson lead notifications</field>
        <field name="model_id" ref="model_odx_whatsapp_salesperson_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
