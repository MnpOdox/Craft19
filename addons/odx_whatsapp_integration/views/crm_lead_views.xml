<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_whatsapp" model="ir.ui.view"><field name="name">crm.lead.form.whatsapp.private</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.crm_lead_view_form"/><field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
            <field name="whatsapp_can_access" invisible="1"/>
            <field name="whatsapp_conversation_count" invisible="1"/>
            <widget name="odx_whatsapp_lead_drawer" groups="odx_whatsapp_integration.group_whatsapp_user" invisible="not id or not whatsapp_can_access"/>
        </xpath>
        <xpath expr="//field[@name='phone']" position="after"><field name="whatsapp_phone" readonly="1" optional="hide"/><field name="whatsapp_previous_lead_id" readonly="1" optional="hide"/><field name="whatsapp_auto_template_state" readonly="1" invisible="not meta_lead_id"/><field name="whatsapp_auto_template_message_id" readonly="1" invisible="not meta_lead_id or not whatsapp_auto_template_message_id"/><field name="whatsapp_auto_template_error" readonly="1" invisible="not meta_lead_id or not whatsapp_auto_template_error"/></xpath>
        <xpath expr="//notebook" position="inside">
            <page string="WhatsApp Automation" groups="odx_whatsapp_integration.group_whatsapp_manager" invisible="not meta_lead_id or not whatsapp_automation_state">
                <group>
                    <group>
                        <field name="whatsapp_automation_state"/>
                        <field name="whatsapp_automation_started_at"/>
                        <field name="whatsapp_automation_next_step_id"/>
                        <field name="whatsapp_automation_next_run_at"/>
                    </group>
                    <group>
                        <field name="whatsapp_automation_last_sent_at"/>
                        <field name="whatsapp_automation_last_message_id"/>
                        <field name="whatsapp_automation_retry_count"/>
                        <field name="whatsapp_automation_completion_reason"/>
                    </group>
                </group>
                <field name="whatsapp_automation_error" readonly="1" invisible="not whatsapp_automation_error"/>
            </page>
            <page string="Salesperson WhatsApp Notifications" groups="odx_whatsapp_integration.group_whatsapp_manager" invisible="not meta_lead_id">
                <field name="whatsapp_salesperson_notification_ids" readonly="1">
                    <list create="0" delete="0"><field name="create_date"/><field name="salesperson_id"/><field name="recipient_phone"/><field name="send_mode"/><field name="state"/><field name="action"/><field name="action_at"/><field name="error_message" optional="show"/></list>
                </field>
            </page>
        </xpath>
    </field></record>
</odoo>
