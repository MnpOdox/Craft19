<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_conversation_list" model="ir.ui.view">
        <field name="name">odx.whatsapp.conversation.list</field><field name="model">odx.whatsapp.conversation</field>
        <field name="arch" type="xml"><list create="0" delete="0" default_order="last_message_at desc"><field name="partner_name"/><field name="partner_phone"/><field name="lead_id"/><field name="owner_id"/><field name="last_message_at"/><field name="unread_count" decoration-warning="unread_count &gt; 0"/><field name="state"/></list></field>
    </record>
    <record id="view_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">odx.whatsapp.conversation.form</field><field name="model">odx.whatsapp.conversation</field>
        <field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_mark_read" type="object" string="Mark Read" invisible="unread_count == 0"/><field name="state" widget="statusbar"/></header><sheet>
            <div class="oe_button_box" name="button_box"><button name="action_compose" type="object" class="oe_stat_button" icon="fa-paper-plane"><div class="o_stat_info"><span class="o_stat_text">Send Message</span></div></button></div>
            <group><group><field name="partner_name" readonly="1"/><field name="partner_phone" readonly="1"/><field name="lead_id" readonly="1"/></group><group><field name="account_id" readonly="1"/><field name="owner_id" readonly="1"/><field name="last_inbound_at" readonly="1"/><field name="last_message_at" readonly="1"/></group></group>
            <field name="message_ids" nolabel="1"><list create="0" edit="0" delete="0" default_order="message_at desc"><field name="message_at"/><field name="direction"/><field name="message_type"/><field name="body"/><field name="attachment" filename="attachment_name"/><field name="attachment_name" column_invisible="True"/><field name="state" decoration-danger="state == 'failed'"/><field name="error_message" optional="hide"/></list></field>
        </sheet></form></field>
    </record>
    <record id="view_whatsapp_account_list" model="ir.ui.view"><field name="name">odx.whatsapp.account.list</field><field name="model">odx.whatsapp.account</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="display_phone"/><field name="team_id"/><field name="webhook_state"/><field name="active"/></list></field></record>
    <record id="view_whatsapp_account_form" model="ir.ui.view"><field name="name">odx.whatsapp.account.form</field><field name="model">odx.whatsapp.account</field><field name="arch" type="xml"><form><header><button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/><button name="action_sync_templates" type="object" string="Sync Templates"/></header><sheet>
        <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="app_id"/><field name="waba_id"/><field name="phone_number_id"/><field name="display_phone" readonly="1"/><field name="graph_version"/></group><group><field name="access_token" password="True"/><field name="app_secret" password="True"/><field name="verify_token" widget="CopyClipboardChar"/><field name="team_id"/><field name="fallback_user_id"/><field name="default_country_code"/><field name="webhook_state" readonly="1"/><field name="active"/></group></group>
        <group string="Webhook"><field name="webhook_base_url" required="1" placeholder="https://example.com"/><field name="webhook_callback_url" readonly="1" widget="CopyClipboardChar"/></group>
        <notebook><page string="Templates"><field name="template_ids"><list create="0" delete="0"><field name="name"/><field name="language"/><field name="category"/><field name="status"/><field name="active"/></list></field></page></notebook>
    </sheet><chatter/></form></field></record>
    <record id="view_whatsapp_template_list" model="ir.ui.view"><field name="name">odx.whatsapp.template.list</field><field name="model">odx.whatsapp.template</field><field name="arch" type="xml"><list create="0" delete="0"><field name="name"/><field name="account_id"/><field name="language"/><field name="category"/><field name="status"/><field name="active"/></list></field></record>
    <record id="view_whatsapp_event_list" model="ir.ui.view"><field name="name">odx.whatsapp.event.list</field><field name="model">odx.whatsapp.event</field><field name="arch" type="xml"><list create="0" delete="0"><field name="create_date"/><field name="account_id"/><field name="state" decoration-danger="state == 'failed'" decoration-success="state == 'done'"/><field name="retry_count"/><field name="processed_at"/><field name="error_message"/></list></field></record>
    <record id="action_whatsapp_conversation" model="ir.actions.act_window"><field name="name">My WhatsApp Conversations</field><field name="res_model">odx.whatsapp.conversation</field><field name="view_mode">list,form</field><field name="context">{'search_default_open': 1}</field></record>
    <record id="action_whatsapp_inbox" model="ir.actions.client"><field name="name">WhatsApp Inbox</field><field name="tag">odx_whatsapp_integration.Inbox</field></record>
    <record id="action_whatsapp_account" model="ir.actions.act_window"><field name="name">WhatsApp Accounts</field><field name="res_model">odx.whatsapp.account</field><field name="view_mode">list,form</field></record>
    <record id="action_whatsapp_template" model="ir.actions.act_window"><field name="name">Templates</field><field name="res_model">odx.whatsapp.template</field><field name="view_mode">list,form</field></record>
    <record id="action_whatsapp_event" model="ir.actions.act_window"><field name="name">Webhook Events</field><field name="res_model">odx.whatsapp.event</field><field name="view_mode">list,form</field></record>
    <record id="action_whatsapp_compose" model="ir.actions.act_window"><field name="name">Send WhatsApp Message</field><field name="res_model">odx.whatsapp.compose</field><field name="view_mode">form</field><field name="target">new</field></record>
</odoo>
