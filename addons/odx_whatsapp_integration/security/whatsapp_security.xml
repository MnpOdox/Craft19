<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp" model="ir.module.category"><field name="name">WhatsApp</field><field name="sequence">35</field></record>
    <record id="privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field><field name="sequence">10</field><field name="category_id" ref="module_category_whatsapp"/>
    </record>
    <record id="group_whatsapp_user" model="res.groups"><field name="name">WhatsApp User</field><field name="privilege_id" ref="privilege_whatsapp"/><field name="sequence">10</field><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
    <record id="group_whatsapp_manager" model="res.groups"><field name="name">WhatsApp Manager</field><field name="privilege_id" ref="privilege_whatsapp"/><field name="sequence">20</field><field name="implied_ids" eval="[(4, ref('group_whatsapp_user')), (4, ref('sales_team.group_sale_manager'))]"/><field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/></record>

    <record id="rule_whatsapp_conversation_owner" model="ir.rule">
        <field name="name">WhatsApp conversation: assigned salesperson only</field><field name="model_id" ref="model_odx_whatsapp_conversation"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_whatsapp_conversation_manager" model="ir.rule">
        <field name="name">WhatsApp conversation: manager all</field><field name="model_id" ref="model_odx_whatsapp_conversation"/>
        <field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_whatsapp_message_owner" model="ir.rule">
        <field name="name">WhatsApp message: assigned salesperson only</field><field name="model_id" ref="model_odx_whatsapp_message"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_whatsapp_message_manager" model="ir.rule">
        <field name="name">WhatsApp message: manager all</field><field name="model_id" ref="model_odx_whatsapp_message"/>
        <field name="domain_force">[(1, '=', 1)]</field><field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
        <field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_whatsapp_company_account" model="ir.rule"><field name="name">WhatsApp accounts: company</field><field name="model_id" ref="model_odx_whatsapp_account"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/></record>
    <record id="rule_whatsapp_company_template" model="ir.rule"><field name="name">WhatsApp templates: company</field><field name="model_id" ref="model_odx_whatsapp_template"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_whatsapp_user'))]"/></record>
    <record id="rule_meta_whatsapp_followup_step_company" model="ir.rule">
        <field name="name">Meta WhatsApp follow-up steps: company</field>
        <field name="model_id" ref="model_odx_meta_whatsapp_followup_step"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_whatsapp_manager'))]"/>
    </record>
</odoo>
