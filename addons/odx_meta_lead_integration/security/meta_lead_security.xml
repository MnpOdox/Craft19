<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_meta_leads" model="ir.module.category"><field name="name">Meta Leads</field><field name="sequence">34</field></record>
    <record id="privilege_meta_leads" model="res.groups.privilege">
        <field name="name">Meta Leads</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_meta_leads"/>
    </record>
    <record id="group_meta_lead_manager" model="res.groups">
        <field name="name">Meta Lead Manager</field>
        <field name="privilege_id" ref="privilege_meta_leads"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_meta_page_company" model="ir.rule"><field name="name">Meta pages: company</field><field name="model_id" ref="model_odx_meta_page"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
    <record id="rule_meta_form_company" model="ir.rule"><field name="name">Meta forms: company</field><field name="model_id" ref="model_odx_meta_form"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
</odoo>
