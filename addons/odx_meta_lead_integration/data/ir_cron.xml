<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_meta_lead_reconcile" model="ir.cron">
        <field name="name">Meta Leads: reconcile submissions</field>
        <field name="model_id" ref="model_odx_meta_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_meta_lead_retry" model="ir.cron">
        <field name="name">Meta Leads: retry failed imports</field>
        <field name="model_id" ref="model_odx_meta_import_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_meta_ad_sync" model="ir.cron">
        <field name="name">Meta Leads: synchronize lead ads</field>
        <field name="model_id" ref="model_odx_meta_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_ads()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_meta_status_retry" model="ir.cron">
        <field name="name">Meta Leads: retry CRM status feedback</field>
        <field name="model_id" ref="model_odx_meta_status_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
