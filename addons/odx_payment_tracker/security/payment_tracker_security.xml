<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_payment_tracker_user" model="res.groups">
        <field name="name">Payment Tracker User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_payment_tracker_manager" model="res.groups">
        <field name="name">Payment Tracker Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_payment_tracker_user')), (4, ref('odx_books.group_book_manager'))]"/>
    </record>

    <record id="payment_tracker_schedule_company_rule" model="ir.rule">
        <field name="name">Payment schedules by company</field>
        <field name="model_id" ref="model_payment_tracker_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payment_tracker_user'))]"/>
    </record>
    <record id="payment_tracker_payment_company_rule" model="ir.rule">
        <field name="name">Tracker payments by company</field>
        <field name="model_id" ref="model_payment_tracker_payment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_payment_tracker_user'))]"/>
    </record>
</odoo>
